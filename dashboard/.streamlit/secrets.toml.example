# Yeh file COPY kar ke Streamlit Cloud Settings -> Secrets mein paste karein
# (asal secrets.toml file kabhi GitHub par push na karein)

MONGODB_URI = "your_mongodb_connection_string_here"

# Optional: manual "Run bot now" button ke liye
GITHUB_TOKEN = "your_github_personal_access_token"
GITHUB_REPO = "your_username/next-apply-alert-bot"
